# Dependencies
node_modules/

# Build outputs
ReleaseScenarios/
Scenarios/*/dist/
TestScenarios/*/dist/

# LOD variants, generated beside a scenario but deliberately outside assets/ so
# build-package.mjs never copies them into the ZIP — only the manifest addresses
# them. Regenerable from the tracked sources; see docs/PLAN.md P3.
Scenarios/*/lods/
TestScenarios/*/lods/

# Generated by `npm run build -- --ktx2`, next to the source images they are
# encoded from. Regenerable with KTX-Software; the source .jpg/.png stay tracked.
*.ktx2

# IDE
.idea/

# Logs
*.log
